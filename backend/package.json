{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "node --env-file=.env node_modules/vitest/vitest.mjs run --no-file-parallelism",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "migrate:down": "tsx --env-file=.env src/db/migrate.ts down",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts"
  },
  "keywords": [],
